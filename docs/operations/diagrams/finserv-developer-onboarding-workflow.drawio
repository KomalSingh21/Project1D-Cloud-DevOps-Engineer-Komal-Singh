<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram id="finserv-onboarding" name="Developer Onboarding Workflow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="FinServ Digital Developer Onboarding Workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="44" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Template → signed image → development namespace → approved secrets → self-service diagnosis and access requests" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1400" height="26" as="geometry"/></mxCell>
        <mxCell id="b22" value="&lt;b style=&quot;font-size:15px&quot;&gt;B2.2 &amp;#10003; Vikram can complete this workflow without prior Helm expertise&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;The template supplies the chart scaffold, so Vikram only fills in service values (steps 1–2). Lint, scan, signing and admission checks give automatic pass / fail feedback (steps 4–8). Vault Agent delivers approved secrets, and extra access follows a guided request path (steps 10–13).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DAE8FC;strokeColor=#3B6FB6;strokeWidth=2;fontColor=#12305C;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="980" height="92" as="geometry"/></mxCell>
        <mxCell id="legend" value="" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9AA4B2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="780" height="92" as="geometry"/></mxCell>
        <mxCell id="legend_t" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1116" y="106" width="80" height="20" as="geometry"/></mxCell>
        <mxCell id="lg1s" value="" style="rounded=1;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1116" y="132" width="34" height="20" as="geometry"/></mxCell>
        <mxCell id="lg1t" value="Approved / automated flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1160" y="130" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="lg2s" value="" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.15;fillColor=#FFD966;strokeColor=#B7791F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1116" y="160" width="34" height="20" as="geometry"/></mxCell>
        <mxCell id="lg2t" value="Approval gate" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1160" y="158" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="lg3s" value="" style="rounded=1;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1500" y="132" width="34" height="20" as="geometry"/></mxCell>
        <mxCell id="lg3t" value="Prohibited action" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1544" y="130" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="lg4s" value="" style="endArrow=block;endFill=1;dashed=1;strokeWidth=2;strokeColor=#2E7D32;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1500" y="170" as="sourcePoint"/><mxPoint x="1534" y="170" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg4t" value="Policy-update feedback loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="1544" y="158" width="290" height="24" as="geometry"/></mxCell>
        <mxCell id="lane_dev" value="Developer" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fillColor=#E3E8EF;strokeColor=#8A94A6;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontColor=#1F2937;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="210" width="2480" height="190" as="geometry"/></mxCell>
        <mxCell id="lane_ci" value="Git repository / CI pipeline" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fillColor=#E3E8EF;strokeColor=#8A94A6;swimlaneFillColor=#F6F8FB;fontStyle=1;fontSize=13;fontColor=#1F2937;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="2480" height="190" as="geometry"/></mxCell>
        <mxCell id="lane_reg" value="Container registry and security controls" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fillColor=#E3E8EF;strokeColor=#8A94A6;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontColor=#1F2937;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="2480" height="190" as="geometry"/></mxCell>
        <mxCell id="lane_k8s" value="Kubernetes development namespace" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fillColor=#E3E8EF;strokeColor=#8A94A6;swimlaneFillColor=#F6F8FB;fontStyle=1;fontSize=13;fontColor=#1F2937;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="2480" height="190" as="geometry"/></mxCell>
        <mxCell id="lane_vault" value="Vault and security approval" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;startSize=50;fillColor=#E3E8EF;strokeColor=#8A94A6;swimlaneFillColor=#FFFFFF;fontStyle=1;fontSize=13;fontColor=#1F2937;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="2480" height="190" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;1. Receive service template&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Golden-path repo template&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_dev"><mxGeometry x="70" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. Create service &amp;amp; Helm values&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Fill in values only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_dev"><mxGeometry x="270" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. Submit pull request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Review required to merge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_dev"><mxGeometry x="470" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. Tests &amp;amp; Helm lint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Automatic pass / fail feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_ci"><mxGeometry x="670" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. Build image&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Immutable version tag / digest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_ci"><mxGeometry x="870" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;6. Trivy scan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Vulnerability policy gate&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.1;whiteSpace=wrap;html=1;fillColor=#FFD966;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#4A3200;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_reg"><mxGeometry x="1070" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. Cosign signing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Sign the image digest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_reg"><mxGeometry x="1270" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;8. Admission verification&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Signed images only&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.1;whiteSpace=wrap;html=1;fillColor=#FFD966;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#4A3200;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_reg"><mxGeometry x="1470" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;9. Deploy to dev namespace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Helm release of signed image&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_k8s"><mxGeometry x="1670" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;10. Vault Agent injects approved secrets&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_k8s"><mxGeometry x="1870" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="nv" value="&lt;b&gt;Approved secret paths&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Scoped Vault policy per service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_vault"><mxGeometry x="1870" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;11. View logs &amp;amp; diagnose Pods&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Read-only, dev namespace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_dev"><mxGeometry x="2070" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n12" value="&lt;b&gt;12. Request extra secret permissions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Access request workflow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#DFF3DC;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#173B1B;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="lane_dev"><mxGeometry x="2270" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="n13" value="&lt;b&gt;13. Security approval&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Least-privilege grant&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.1;whiteSpace=wrap;html=1;fillColor=#FFD966;strokeColor=#B7791F;strokeWidth=2;fontSize=12;fontColor=#4A3200;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="lane_vault"><mxGeometry x="2270" y="36" width="160" height="80" as="geometry"/></mxCell>
        <mxCell id="r1" value="&lt;b&gt;✕ No secrets in Git&lt;/b&gt;&lt;br&gt;Secrets come from Vault only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#B71C1C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="lane_dev"><mxGeometry x="270" y="128" width="190" height="54" as="geometry"/></mxCell>
        <mxCell id="r2" value="&lt;b&gt;✕ No mutable &lt;i&gt;latest&lt;/i&gt; tag&lt;/b&gt;&lt;br&gt;Use immutable version / digest" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#B71C1C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="lane_ci"><mxGeometry x="870" y="128" width="190" height="54" as="geometry"/></mxCell>
        <mxCell id="r3" value="&lt;b&gt;✕ No unrestricted production exec&lt;/b&gt;&lt;br&gt;Diagnose via logs and describe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#B71C1C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="lane_k8s"><mxGeometry x="2070" y="128" width="190" height="54" as="geometry"/></mxCell>
        <mxCell id="r4" value="&lt;b&gt;✕ No broad wildcard Vault access&lt;/b&gt;&lt;br&gt;Grant specific paths only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FDECEA;strokeColor=#C62828;strokeWidth=2;fontSize=11;fontColor=#B71C1C;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;" vertex="1" parent="lane_vault"><mxGeometry x="2270" y="128" width="190" height="54" as="geometry"/></mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
