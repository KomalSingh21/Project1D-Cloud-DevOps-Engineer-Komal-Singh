<mxCell id="title" value="&lt;b&gt;FinServ Digital Platform Operations Lifecycle&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontColor=#1F4E79;" vertex="1" parent="1"><mxGeometry x="40" y="8" width="900" height="36" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Detect → Triage → Diagnose → Remediate → Validate → Close  |  decision gates, security track and separate B3.4 capacity branch" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1100" height="20" as="geometry"/></mxCell>
<mxCell id="st1" value="1 · DETECT" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st1b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Metrics and SLO alerts (latency, errors, saturation)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Application and platform logs&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Kubernetes events (Warning, BackOff, FailedScheduling)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Falco runtime security alerts&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Kubernetes audit alerts&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st1"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="st2" value="2 · TRIAGE" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="294" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st2b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Confirm cluster and namespace&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Assess customer and business impact&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Check recent changes (deploys, config, certificates, policy)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Set severity and assign an owner&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Open incident channel and comms&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st2"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="st3" value="3 · DIAGNOSE" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="956" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st3b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Pod inspection (describe, restarts, probes)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Logs (current and previous containers)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Events and scheduling&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;DNS resolution (CoreDNS)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;NetworkPolicy connectivity&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Resources (requests, limits, quotas, node pressure)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Admission and policy reports&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st3"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="st4" value="4 · REMEDIATE" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1414" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st4b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Rollout rollback to last known good&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Controlled scaling (replicas, HPA, quota-aware)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Node cordon and drain&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Certificate rotation or restore&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Record change and approval (emergency change if needed)&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st4"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="st5" value="5 · VALIDATE" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1668" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st5b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Health checks (readiness, liveness, endpoints)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;mTLS between services&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Vault secret injection&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Policy enforcement (admission, NetworkPolicy)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Transaction smoke tests&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Alerts cleared, SLOs recovering&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st5"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="st6" value="6 · CLOSE" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=6;fillColor=#1F4E79;strokeColor=#1F4E79;fontColor=#FFFFFF;swimlaneFillColor=#FFFFFF;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1922" y="150" width="210" height="270" as="geometry"/></mxCell>
<mxCell id="st6b" value="&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Evidence capture (timeline, logs, artifacts)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Root cause analysis&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Action items with owners and dates&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Compliance references (controls, change and audit records)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Runbook, alert and policy updates&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=hidden;spacingLeft=6;spacingRight=6;spacingTop=6;fontSize=11;fontColor=#222222;" vertex="1" parent="st6"><mxGeometry x="0" y="36" width="210" height="234" as="geometry"/></mxCell>
<mxCell id="d1" value="Is customer impact ongoing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="layer-decisions"><mxGeometry x="548" y="215" width="160" height="140" as="geometry"/></mxCell>
<mxCell id="d2" value="Is the event security-related?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="layer-decisions"><mxGeometry x="752" y="215" width="160" height="140" as="geometry"/></mxCell>
<mxCell id="d3" value="Is rollback safer than forward fix?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#333333;spacing=0;" vertex="1" parent="layer-decisions"><mxGeometry x="1210" y="215" width="160" height="140" as="geometry"/></mxCell>
<mxCell id="m1" value="&lt;b&gt;Mitigate first (parallel track)&lt;/b&gt;&lt;br&gt;Declare Sev1/Sev2, open bridge, status comms, stop the bleed while diagnosis continues" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;fillColor=#FFE8CC;strokeColor=#E08A00;dashed=1;" vertex="1" parent="layer-decisions"><mxGeometry x="548" y="66" width="160" height="94" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;Security incident track&lt;/b&gt;&lt;br&gt;Page SecOps, preserve evidence (audit + Falco), isolate via NetworkPolicy, no destructive changes until cleared" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;fillColor=#FDE9E7;strokeColor=#C0392B;" vertex="1" parent="layer-decisions"><mxGeometry x="712" y="450" width="240" height="100" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;Forward fix&lt;/b&gt;&lt;br&gt;Expedited change control: peer review, canary apply, rollback point ready" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;strokeWidth=2;fillColor=#E8F0FA;strokeColor=#1F4E79;" vertex="1" parent="layer-decisions"><mxGeometry x="1190" y="450" width="200" height="100" as="geometry"/></mxCell>
