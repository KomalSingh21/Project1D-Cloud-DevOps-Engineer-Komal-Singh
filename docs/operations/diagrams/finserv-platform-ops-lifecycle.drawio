<mxCell id="b_2x" value="&lt;b style='font-size:16px'&gt;2x&lt;/b&gt;&lt;br&gt;baseline multiple" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;fontSize=11;" vertex="1" parent="b_ramp"><mxGeometry x="150" y="70" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="b_3x" value="&lt;b style='font-size:16px'&gt;3x&lt;/b&gt;&lt;br&gt;baseline multiple" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;fontSize=11;" vertex="1" parent="b_ramp"><mxGeometry x="280" y="70" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="b_5x" value="&lt;b style='font-size:16px'&gt;5x&lt;/b&gt;&lt;br&gt;baseline multiple" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;fontSize=11;" vertex="1" parent="b_ramp"><mxGeometry x="410" y="70" width="110" height="70" as="geometry"/></mxCell>
<mxCell id="b_abort" value="&lt;i&gt;Abort and ramp down if SLO or error budget is breached&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=10;fontColor=#555555;" vertex="1" parent="b_ramp"><mxGeometry x="20" y="150" width="500" height="20" as="geometry"/></mxCell>
<mxCell id="b_hpa" value="&lt;b&gt;HPA response&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Scale-out trigger time and metric lag&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Replicas vs min/max ceiling&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Pending pods and node capacity&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="870" y="60" width="220" height="160" as="geometry"/></mxCell>
<mxCell id="b_cap" value="&lt;b&gt;Capacity and latency checks&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;p95/p99 latency vs SLO at each step&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Error rate and saturation (CPU, memory, throttling)&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Quota, PDB and dependency limits (DB, queues)&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="1130" y="60" width="250" height="160" as="geometry"/></mxCell>
<mxCell id="b_rec" value="&lt;b&gt;Recovery and report&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Ramp down and confirm scale-in&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Return to baseline, no residual errors&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Report: headroom, findings, action items&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="1420" y="60" width="250" height="160" as="geometry"/></mxCell>
<mxCell id="b_note" value="&lt;b&gt;Entry:&lt;/b&gt; scheduled capacity validation, or after controlled scaling in Remediate.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exit:&lt;/b&gt; report feeds Validate evidence and Close action items." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;dashed=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="1710" y="60" width="350" height="160" as="geometry"/></mxCell>
