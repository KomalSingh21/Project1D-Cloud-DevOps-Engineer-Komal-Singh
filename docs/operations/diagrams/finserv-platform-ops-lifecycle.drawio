<mxCell id="e_fail" value="Any gate fails: re-diagnose or escalate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#333333;endArrow=block;endFill=1;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;strokeColor=#C00000;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="st5" target="st3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1773" y="105"/><mxPoint x="1061" y="105"/></Array></mxGeometry></mxCell>
