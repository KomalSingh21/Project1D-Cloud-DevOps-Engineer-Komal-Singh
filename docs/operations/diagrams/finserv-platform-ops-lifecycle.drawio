<mxCell id="b34" value="B3.4 · Controlled Load and Capacity Validation (separate branch)" style="swimlane;fontStyle=1;fontSize=13;startSize=36;rounded=1;arcSize=4;fillColor=#2D7D46;strokeColor=#2D7D46;fontColor=#FFFFFF;swimlaneFillColor=#F1F8F3;whiteSpace=wrap;html=1;collapsible=0;" vertex="1" parent="layer-b34"><mxGeometry x="40" y="700" width="2092" height="250" as="geometry"/></mxCell>
<mxCell id="b_base" value="&lt;b&gt;Baseline&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin:0;padding-left:14px;&quot;&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Steady-state RPS, p95/p99 latency, error rate&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;CPU, memory, replicas, HPA min/max&lt;/li&gt;&lt;li style=&quot;margin-bottom:3px;&quot;&gt;Healthy pods, no active alerts&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2D7D46;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="30" y="60" width="220" height="160" as="geometry"/></mxCell>
<mxCell id="b_ramp" value="&lt;b&gt;Controlled load ramp&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;hold and measure at each step&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E3F1E7;strokeColor=#2D7D46;strokeWidth=2;dashed=1;align=center;verticalAlign=top;fontSize=11;spacingTop=6;" vertex="1" parent="b34"><mxGeometry x="290" y="50" width="540" height="180" as="geometry"/></mxCell>
